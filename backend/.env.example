# Server
NODE_ENV=development
PORT=8000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/intelliprep

# Auth / JWT
# Access tokens are short-lived and held in memory on the client.
# Refresh tokens are opaque random strings stored hashed in the database and
# delivered to the browser as an HttpOnly cookie (see COOKIE_* below).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=10m
JWT_ISSUER=intelliprep
JWT_AUDIENCE=intelliprep-web
REFRESH_TOKEN_EXPIRES_IN=30d

# Refresh cookie
REFRESH_COOKIE_NAME=ip_rt
# Leave unset to default to true when NODE_ENV=production.
COOKIE_SECURE=
# Optional. Set to the parent domain to share the cookie across subdomains.
COOKIE_DOMAIN=

# CORS: comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate limiting (Redis). If unreachable, rate limiting fails open.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Express trust proxy hop count (1 behind a single reverse proxy / PaaS router)
TRUST_PROXY=1

# Outbound email (OTP delivery)
Email_User=
Email_Pass=

# Google Gemini (interview question generation + summaries)
GEMINI_API_KEY=
